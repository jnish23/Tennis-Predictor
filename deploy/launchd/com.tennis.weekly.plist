<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tennis.weekly</string>

  <!-- Full re-check of every historical file plus a model refit and backtest.
       ~25 min. One day of results cannot move a model fit on 200k matches, so
       this is weekly rather than daily. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jordannishimura/Tennis Predictor/scripts/daily.sh</string>
    <string>--retrain</string>
    <string>--full-history</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jordannishimura/Tennis Predictor</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/jordannishimura/Tennis Predictor/data/launchd-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jordannishimura/Tennis Predictor/data/launchd-weekly.log</string>
</dict>
</plist>
